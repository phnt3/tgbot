# PC Remote Bot Configuration
# Copy this file to .env and fill in your values.

# Telegram Bot Token - obtain from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Only these users can control the bot. Obtain your user ID by talking to @userinfobot.
ALLOWED_USER_IDS=123456789

# Application paths configuration (overrides default config)
# These paths are used by the application launcher
# Format: key=path_to_executable
# APP_STEAM=
# APP_DISCORD=